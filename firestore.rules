rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'alexiusdubem7@gmail.com' ||
         request.auth.token.email == 'alexiusdubem7@GMAIL.COM');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Punters profile telemetry & session access
    match /users/{userId} {
      // Admin can read and delete all users for platform telemetry; owner can read/write their own
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // Slips subcollection
      match /slips/{slipId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write, delete: if isOwner(userId) || isAdmin();
      }

      // Web Push Tokens for phone notifications
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // User notifications — strictly owner or admin
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Global push subscribers for phone broadcasts
    match /push_subscribers/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() || isAdmin();
    }

    // Global broadcasts: readable by all punters, strictly managed by superadmin
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Telemetry and auditing collections
    match /dropped_picks/{pickId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }

    match /processed_matches/{matchId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}
